    {
      "level": 1,
      "title": "Confusing scenario:"
    },
    {
      "level": 1,
      "title": "File on disk: C:\\Tools\\compression-tool.exe"
    },
    {
      "level": 1,
      "title": "VERSIONINFO OriginalFileName: 7z.exe"
    },
    {
      "level": 1,
      "title": "VERSIONINFO FileVersion: 24.08.0.0"
    },
    {
      "level": 1,
      "title": "Signed by: Igor Pavlov cert chain"
    },
    {
      "level": 1,
      "title": "FilePublisher rule has FileName=\"7z.exe\""
    },
    {
      "level": 1,
      "title": "Even though file is named \"compression-tool.exe\" on disk,"
    },
    {
      "level": 1,
      "title": "it WILL match the FilePublisher rule because OriginalFileName=\"7z.exe\""
    },
    {
      "level": 1,
      "title": "This is by design — prevents bypass by renaming"
